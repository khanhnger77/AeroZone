# Rebuilt inside the image
.pixi/
**/node_modules/
frontend/dist/
**/__pycache__/
**/*.pyc
.pytest_cache/
sim/.tools/
.git/

# Never ship secrets: the Space reads OPENROUTER_API_KEY from its own secret settings
api_key.credentials
*.credentials

# Large raw sources the app does not read at run time (the derived rasters are enough)
data/raw/hirise_dtm/*.tif
data/raw/**/*.part
media/
