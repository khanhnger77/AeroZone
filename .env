# ==============================================================================
# MARS ODYSSEY COPILOT - API KEY CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# LỰA CHỌN 1: OPENROUTER (Khuyên dùng khi Gemini hết token/quota)
# Đăng ký key tại: https://openrouter.ai/keys (Bắt đầu bằng: sk-or-v1-...)
# ------------------------------------------------------------------------------
# The key itself lives in the untracked file api_key.credentials (see README, "Odyssey Copilot").
OPENROUTER_API_KEY=file:api_key.credentials
#OPENROUTER_MODEL="google/gemini-2.0-flash-001"
# Gợi ý các model OpenRouter khác:
# OPENROUTER_MODEL="mistralai/mistral-small-3.2-24b-instruct"
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"
